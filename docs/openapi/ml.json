  "components": {
    "schemas": {
      "ExportUrlResult": {
        "type": "object",
        "properties": {
          "TenantId": {
            "type": "string",
            "format": "uuid"
          },
          "Id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "MlModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Identifier": {
            "type": "string",
            "nullable": true
          },
          "Type": {
            "$ref": "#/components/schemas/MlModelTypes"
          },
          "TrainSql": {
            "type": "string",
            "nullable": true
          },
          "TrainState": {
            "$ref": "#/components/schemas/MlModelTrainingStates"
          },
          "TrainResult": {
            "type": "string",
            "nullable": true
          },
          "Options": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "MlModelSelectListEntry": {
        "required": [
          "Identifier"
        ],
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Identifier": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "MlModelTrainingStates": {
        "enum": [
          0,
          1,
          5,
          6,
          10,
          99
        ],
        "type": "integer",
        "format": "int32"
      },
      "MlModelTypes": {
        "enum": [
          0,
          1
        ],
        "type": "integer",
        "format": "int32"
      },
      "StringStringValuesKeyValuePair": {
        "type": "object",
        "properties": {
          "Key": {
            "type": "string",
            "nullable": true
          },
          "Value": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "oidc": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://localhost/.well-known/openid-configuration"
      }
